# Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
venv311/

# Node / frontend build output
node_modules/
dist/
dist-ssr/

# ログイントークン署名鍵（サーバーごとに個別生成 — コミット禁止）
backend/.auth_secret
# サーバー設定（パスワード等 — deploy/env.example をコピーして作成。コミット禁止）
.env

# Runtime uploads and generated media
storage/
data/
data/train/*.mp4

# 診断・デバッグ成果物（検知結果画像など）
outputs/

# ローカルラベリングツール — 個人作業用のためコミット対象外
labeling/

# 本番モデルは model/(x3d)。旧 s3d バックボーンはローカル比較用として保持
s3d model/

# Model weights (大容量バイナリ — git除外)
weights/

# YOLO / torch チェックポイント (大容量 — 初回実行時に自動ダウンロード)
*.pt

# Local notebooks and docs
*.ipynb
*.md
# チーム向けオンボーディング文書(README)はリポジトリに含める
!README.md
# サーバーデプロイ手順書
!deploy/DEPLOY.md

# Local editor and OS files
.vscode/
.idea/
.DS_Store
._*
*.local
venv311
