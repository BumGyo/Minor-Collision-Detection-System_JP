# Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
venv311/

# Node / frontend build output
node_modules/
dist/
dist-ssr/

# ログインCookie(JWT)署名鍵(サーバーごとに個別生成 — コミット厳禁)
backend/.auth_secret

# This branch's local database credentials.
backend/.env
# サーバー本番環境変数(Supabase・R2 のシークレット値を含む)
.env

# Runtime uploads and generated media
storage/
data/
data/train/*.mp4

# 診断・デバッグ生成物(検知結果画像等)
outputs/

# ローカルアノテーションツール — 個人作業用のためコミット対象外
labeling/

# 本番モデルは model/(x3d)。過去の s3d バックボーンはローカル比較用として保持
s3d model/

# Model weights (大容量バイナリ — git除外)
weights/

# YOLO / torch チェックポイント (大容量 — 初回実行時に自動ダウンロード)
*.pt

# Local notebooks and docs
*.ipynb
*.md
# 開発者向けオンボーディングドキュメント(README)はリポジトリに含める
!README.md
# サーバーデプロイガイドはリポジトリに含める
!deploy/DEPLOY.md

# Local editor and OS files
.vscode/
.idea/
.DS_Store
._*
*.local
