# SIOT バックエンド(FastAPI)。deploy/install.sh が __REPO__·__USER__ を置換して /etc/systemd/system へ登録。
# ログ確認: journalctl -u siot-backend -f
[Unit]
Description=SIOT backend (FastAPI, uvicorn)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/backend
# パスワード等の環境変数はプロジェクトルートの .env より読み込み（docker-compose と共通）
EnvironmentFile=-__REPO__/.env
Environment=PYTHONUNBUFFERED=1
# nginx 経由のリバースプロキシ接続のみを許可(127.0.0.1)。開発用 --reload は不使用
ExecStart=__REPO__/venv311/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
