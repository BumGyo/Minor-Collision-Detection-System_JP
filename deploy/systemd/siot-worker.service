# SIOT 分析ワーカー(Celery)。deploy/install.sh が __REPO__・__USER__ を置換して /etc/systemd/system に登録します。
# ログ確認: journalctl -u siot-worker -f
[Unit]
Description=SIOT analysis worker (Celery)
After=network-online.target docker.service siot-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/backend
EnvironmentFile=-__REPO__/.env
Environment=PYTHONUNBUFFERED=1
# 分析は一度に1件ずつ順次実行(ワーカー1基前提 — app/worker.py の再起動クリーンアップ参照)
ExecStart=__REPO__/venv311/bin/celery -A app.worker worker --concurrency=1 --loglevel=info
Restart=always
RestartSec=5
# 更新・再起動時に実行中分析の完了を長時間待機しない。
# 中断された分析は次回起動時に「失敗」として整理され UI から再実行可能
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
