# SIOT 解析ワーカー(Celery)。deploy/install.sh が __REPO__·__USER__ を置換して /etc/systemd/system へ登録。
# ログ確認: journalctl -u siot-worker -f
[Unit]
Description=SIOT analysis worker (Celery)
After=network-online.target docker.service siot-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/backend
EnvironmentFile=-__REPO__/.env
Environment=PYTHONUNBUFFERED=1
# 解析は一度に1件ずつ順次実行（単一ワーカー前提 — app/worker.py の再起動時クリーンアップ処理参照）
ExecStart=__REPO__/venv311/bin/celery -A app.worker worker --concurrency=1 --loglevel=info
Restart=always
RestartSec=5
# 更新・再起動時に進行中の解析タスク完了を過度に待機しない。
# 中断された解析は次回起動時に「失敗」として適切にロールバックされ、画面から再実行可能
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
