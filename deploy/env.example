# サーバー用設定 — プロジェクトルートに .env としてコピーし値を入力:  cp deploy/env.example .env
# バックエンド・ワーカー(systemd)および deploy/install.sh が本ファイルを読み込む。docker compose も DB/Redis 設定値を使用。
# ⚠️ .env は git にコミットしないこと(.gitignore)。値にはクォート・空白・$ を含めない。

# アクセスURL(ドメイン)。ドメイン未取得で IP のみでアクセスする場合は空欄
DOMAIN=

# Supabase PostgreSQL または Azure Database for PostgreSQL URL。
# パスワード内の特殊文字は percent-encode が必要。空欄時はローカル MySQL 設定を使用。
# Azure App Service の AZURE_POSTGRESQL_CONNECTIONSTRING も自動認識。
DATABASE_URL=
# REDIS_URL を指定した場合、後続の Redis 個別設定値より優先。
# Azure Cache for Redis は rediss://:パスワード@ホスト:6380/0 形式を使用。
# Azure の AZURE_REDIS_CONNECTIONSTRING も自動認識。
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=
REDIS_DB=0
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=capstone_db

# ログインCookie(JWT)署名鍵 — 任意の十分な長さの文字列。生成: openssl rand -hex 32
AUTH_SECRET_KEY=
# ログインセッション有効時間(時間単位)
AUTH_TOKEN_TTL_HOURS=8
# 動画保存期間(日単位) — アップロードからこの期間が経過した動画・分析クリップ・履歴を完全削除(0 で無効)
VIDEO_RETENTION_DAYS=90

# ── オプション設定 ──────────────────────────────────────────────
# 本番重みファイルの変更時(プロジェクトルート基準パス)。空欄時は model/config.py の SERVICE_WEIGHTS_PATH
SERVICE_WEIGHTS=
# 学習済み重みの入力サイズ・時間プーリング設定と一致させる必要あり(既定 224・avg)。
INPUT_SIZE=
HEAD_TEMPORAL_POOL=
# Cloudflare R2 または S3 互換ストレージ。既存の R2 動画がある場合は s3 を選択し全項目を入力。
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# CLOUDFLARE_R2_ACCOUNT_ID / CLOUDFLARE_R2_BUCKET / CLOUDFLARE_R2_ACCESS_KEY_ID /
# CLOUDFLARE_R2_SECRET_ACCESS_KEY aliases are also accepted.
# ローカルストレージ使用時のみ: 大容量ディスクパス(絶対パスまたはプロジェクトルート基準の相対パス)。
STORAGE_DIR=
# 複数の Web オリジンを許可する場合はカンマ区切り。空欄時はローカル開発環境のオリジンを許可。
CORS_ORIGINS=
# GPU アーキテクチャが異なる場合でも FP16 を自動診断し安全な場合のみ適用。
INFER_FP16=1
