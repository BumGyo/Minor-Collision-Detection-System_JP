# サーバー環境設定 — プロジェクトルートに .env としてコピーして値を設定:  cp deploy/env.example .env
# docker-compose · バックエンド/ワーカーサービス(systemd) · deploy/install.sh がすべて本ファイルを参照します。
# ⚠️ .env は git にコミットしないでください(.gitignore)。値には引用符・空白・$ を含めないでください。

# アクセスアドレス(ドメイン)。ドメインがなくIPアドレスのみでアクセスする場合は空欄のまま
DOMAIN=

# DB・Redis パスワード — 半角英数字で長めに設定。バックエンドの接続URLは本値より自動生成されます
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# ログイントークン署名鍵 — 任意の十分な長さの文字列。生成コマンド: openssl rand -hex 32
AUTH_SECRET_KEY=
# ログイン有効保持時間(時間)
AUTH_TOKEN_TTL_HOURS=8
# 動画保管期間(日) — アップロードから指定日数経過後に動画および解析クリップ・履歴を完全削除(0 の場合は無期限保持)
VIDEO_RETENTION_DAYS=90

# ── 必要時のみ設定 ──────────────────────────────────────────
# サービス運用重みを変更する場合(プロジェクトルート基準の相対パス)。空欄時は model/config.py の SERVICE_WEIGHTS_PATH
SERVICE_WEIGHTS=
# モデル入力サイズ — 重み名に _s256 のようなサイズ表記がある場合は同一値を指定(ない場合は空欄 = 224)。不一致時はワーカーが停止
INPUT_SIZE=
# ヘッド時間プーリング — 重み名に _top3・_avgtop3 がある場合は同一値を指定(ない場合は空欄 = avg)。不一致時はワーカーが停止
HEAD_TEMPORAL_POOL=
# 動画保存先フォルダを別ディスクへ退避する場合。空欄時はプロジェクト直下の storage/
STORAGE_DIR=
# GPU FP16 推論(既定有効 — RTX 3080 で結果一致かつ1.2倍高速を確認済み)。別 GPU 環境等で結果に差異が生じる場合は 0
INFER_FP16=1
# 将来的に DB を Supabase 等の外部マネージドサービスへ移行する場合の完全接続URL(設定時は MYSQL_ROOT_PASSWORD は不使用)
DATABASE_URL=
